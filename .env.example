# =============================================================================
# TextReach — environment variables
# Copy to .env and fill in values. See DEPLOY.md for production checklist.
# =============================================================================

# --- Database (required) ---
# Pooled connection string (app runtime). Use your provider's pooler URL when available.
DATABASE_URL=
# Direct connection for migrations/Prisma CLI when DATABASE_URL uses a pooler (Neon, Supabase, etc.).
DIRECT_URL=

# --- App URL (required) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use your tunnel URL only when accessing the app remotely (not for localhost dev):
# NEXT_PUBLIC_APP_URL=https://your-subdomain.trycloudflare.com

# --- Clerk auth (required in production) ---
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk webhook signing secret (Dashboard → Webhooks). Required for /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=
# Legacy alias — also accepted if CLERK_WEBHOOK_SIGNING_SECRET is unset.
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Auto-set to /__clerk for remote hosts (tunnel, vercel.app). Override if needed:
# NEXT_PUBLIC_CLERK_PROXY_URL=/__clerk
# CLERK_FRONTEND_API_PROXY=true

# --- Session / legacy auth ---
# Required for legacy auth and workspace switching (signed active-workspace cookie).
# Min 32 characters. HMAC-signs session cookies; unsigned/tampered cookies are rejected.
SESSION_SECRET=
# Production: use Clerk. Set AUTH_PROVIDER=legacy only for non-Clerk deployments.
# AUTH_PROVIDER=legacy

# --- Twilio (required for SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Platform default sender (dev seed / fallback). Each workspace must configure its own
# Twilio phone number in Settings → Phone Number before inbound SMS routing works.
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Public URL for webhook signature validation (production: same as NEXT_PUBLIC_APP_URL).
TWILIO_WEBHOOK_BASE_URL=
# Optional separate token for webhook validation. Defaults to TWILIO_AUTH_TOKEN if unset.
TWILIO_WEBHOOK_AUTH_TOKEN=
# Allow platform TWILIO_PHONE_NUMBER / TWILIO_MESSAGING_SERVICE_SID when workspace sender is unset.
# Leave unset in production multi-tenant deployments.
# TWILIO_ALLOW_PLATFORM_SENDER_FALLBACK=true
# Fallback support number shown in Twilio delivery error messages when workspace phone is unset.
DEFAULT_SUPPORT_PHONE=
# Local dev only — never set in production:
# TWILIO_WEBHOOK_SKIP_VERIFY=true

# --- Stripe billing (required for paid plans) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# --- Cron / scheduled messages ---
# CRON_SECRET is required in production. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Local only: allow cron route without CRON_SECRET (never set in production)
# CRON_DEV_BYPASS=true

# --- Platform admin (recommended) ---
# Comma-separated emails allowed to access /admin (not linked in app navigation).
TEXTREACH_ADMIN_EMAILS=

# --- Optional tuning ---
LINK_CLICK_IP_SALT=
KEYWORD_APPEND_COMPLIANCE_FOOTER=
